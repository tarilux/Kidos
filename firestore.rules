rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // GLOBAL HELPERS
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }
    
    function getUserData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }
    
    function isParent(familyId) {
      let userData = getUserData(request.auth.uid);
      return userData.familyId == familyId && userData.role == 'parent';
    }
    
    function isFamilyMember(familyId) {
      return getUserData(request.auth.uid).familyId == familyId;
    }

    // -------------------------------------------------------------------------
    // VALIDATION HELPERS
    // -------------------------------------------------------------------------
    function isValidFamily(data) {
      return data.name is string && data.name.size() <= 100 &&
             data.adminId == request.auth.uid &&
             data.inviteCode is string && data.inviteCode.size() >= 6 && data.inviteCode.size() <= 10;
    }

    function isValidUser(data) {
      return data.name is string && data.name.size() <= 50 &&
             data.familyId is string &&
             data.role in ['parent', 'kid'] &&
             (data.points == null || data.points is number);
    }

    function isValidTask(data) {
      return data.title is string && data.title.size() <= 100 &&
             data.points is number &&
             data.status in ['pending', 'completed', 'verified'];
    }

    function isValidReward(data) {
      return data.title is string && data.title.size() <= 100 &&
             data.cost is number;
    }

    // -------------------------------------------------------------------------
    // CATCH-ALL DENY
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // COLLECTIONS
    // -------------------------------------------------------------------------

    // Families
    match /families/{familyId} {
      allow get: if isSignedIn() && (isFamilyMember(familyId) || incoming().inviteCode != null); 
      allow create: if isSignedIn() && isValidFamily(incoming()) && isValidId(familyId);
      allow update: if isSignedIn() && isParent(familyId) && isValidFamily(incoming());
      allow delete: if isSignedIn() && existing().adminId == request.auth.uid;
      
      // Tasks sub-collection
      match /tasks/{taskId} {
        allow list: if isSignedIn() && isFamilyMember(familyId);
        allow get: if isSignedIn() && isFamilyMember(familyId);
        allow create: if isSignedIn() && isParent(familyId) && isValidTask(incoming());
        allow update: if isSignedIn() && isFamilyMember(familyId) && (
          // Parents can update anything
          (isParent(familyId) && isValidTask(incoming())) ||
          // Kids can only update status to 'completed'
          (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'completedBy', 'updatedAt']) && 
           incoming().status == 'completed' && incoming().completedBy == request.auth.uid)
        );
        allow delete: if isSignedIn() && isParent(familyId);
      }

      // Rewards sub-collection
      match /rewards/{rewardId} {
        allow list: if isSignedIn() && isFamilyMember(familyId);
        allow get: if isSignedIn() && isFamilyMember(familyId);
        allow create: if isSignedIn() && isParent(familyId) && isValidReward(incoming());
        allow update: if isSignedIn() && isParent(familyId) && isValidReward(incoming());
        allow delete: if isSignedIn() && isParent(familyId);
      }
    }

    // User Profiles
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn(); // Usually filtered by familyId in app
      allow create: if isSignedIn() && userId == request.auth.uid && isValidUser(incoming());
      allow update: if isSignedIn() && (
        // Self update (limited)
        (userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'avatar'])) ||
        // Parent update (points, etc)
        (isParent(existing().familyId) && isValidUser(incoming()))
      );
    }
  }
}
